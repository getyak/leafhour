READER_HOST=127.0.0.1
READER_PORT=8330
# 域名后续确定。接入域名前先配置反向代理认证。
# READER_PUBLIC_ORIGIN=https://reader.example.com
# 默认使用本机生成的阅读包，也可明确指定其他阅读包路径。
# READER_BOOK_PATH=local/finite-infinite-games/book.json

# DeepSeek Harness 的本机凭证引用；不要填写到前端或内容包中。
# 配置后仅在提交回声时调用。已存译文、透视、字号不触发模型。
DEEPSEEK_API_KEY=

# Email OTP delivery. Without SMTP the UI honestly disables email sending;
# the separate local-library entry works on loopback only.
READER_SMTP_HOST=
READER_SMTP_PORT=587
READER_SMTP_SECURE=false
READER_SMTP_FROM=
READER_SMTP_USER=
READER_SMTP_PASSWORD=
# On-demand, bounded paragraph translation; never translates a whole book automatically.
READER_TRANSLATION_MODEL=deepseek-chat

# Audio is generated only after an explicit request. Never commit a real key.
OPENROUTER_API_KEY=
READER_SPEECH_MODEL=google/gemini-3.8-flash-tts
READER_IMAGE_MODEL=google/gemini-nano-banana-2.1
READER_DIALOGUE_MODEL=deepseek-chat
