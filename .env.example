# Leafhour 唯一配置模板。完整说明：docs/configuration.md
# 本机：复制为 .env，填写需要的 Key，然后 npm start。只阅读可全部留空。
# 托管：把下方“托管部署”的变量填到部署平台，不要上传真实 .env。

# 1. 日常使用：模型已默认选好，只需对应服务商的 Key
# 翻译、阅读对话、讲解稿（本机与托管均可用）
DEEPSEEK_API_KEY=

# Gemini 官方语音，填写 Google AI Studio 的 API Key（本机和已配置的托管实例均支持）
GEMINI_API_KEY=

# 2. 托管部署：下面四项必填；本机阅读跳过整节
# 注释用于避免本机复制后误加载占位配置。请在部署平台逐项填写真实值。
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# READER_PUBLIC_ORIGIN=https://reader.example.com

# 真实邮箱收信与登录验收通过后，才设为 true。
# SMTP、Google / Apple 登录供应商在 Supabase Auth 中配置。
# READER_EMAIL_ENABLED=false

# 3. 高级可选项：通常无需填写，按需取消注释
# READER_PORT=8330
# READER_HOST=127.0.0.1
# READER_BOOK_PATH=/absolute/path/to/book.json
# 模型留空时使用程序默认值；只有要覆盖时才填写。
# READER_TRANSLATION_MODEL=
# READER_AUDIO_SCRIPT_MODEL=
# READER_SPEECH_MODEL=
# 仅托管：额外允许的精确 HTTPS 来源，多个来源以逗号分隔。
# READER_ADDITIONAL_WEB_ORIGINS=https://other-reader.example.com

# 本机 SMTP、MCP 客户端与旧配置兼容：docs/configuration.md
# 真实密钥只保存在 .env 或部署平台；不要提交到 Git。

# PDF 扫描识别：PaddleOCR 官方 API，固定使用 PaddleOCR-VL-1.6
# 仅在用户允许本书发送至服务方后调用；服务器端配置。
PADDLEOCR_ACCESS_TOKEN=
