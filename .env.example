# Leafhour 本机配置。只阅读时，两项都可以留空。
# 翻译、阅读对话、讲解稿：填写 DeepSeek 的 API Key。
DEEPSEEK_API_KEY=

# 语音生成：填写 OpenRouter 的 API Key。
OPENROUTER_API_KEY=

# 以下均为高级可选项；默认不必填写。
# READER_PORT=8330
# READER_HOST=127.0.0.1
# READER_PUBLIC_ORIGIN=https://reader.example.com
# READER_BOOK_PATH=local/finite-infinite-games/book.json
# READER_TRANSLATION_MODEL=deepseek-chat
# READER_AUDIO_SCRIPT_MODEL=deepseek-chat
# READER_SPEECH_MODEL=google/gemini-3.8-flash-tts
# 邮箱、自托管与旧配置兼容说明：docs/configuration.md
