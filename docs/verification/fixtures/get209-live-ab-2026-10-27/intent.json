            {
              "id": "L1",
              "kind": "line",
              "text": "左栏一：河流从山间来，先经过松林，再经过村庄。"
            },
            {
              "id": "L2",
              "kind": "line",
              "text": "左栏二：村民在河边洗衣，也在河边交换一天的新闻。"
            },
            {
              "id": "L3",
              "kind": "line",
              "text": "左栏三：桥是去年新修的，桥头刻着捐资人的名字。①"
            },
            {
              "id": "L4",
              "kind": "line",
              "text": "左栏四：孩子们放学后爱在桥上看船，直到天色变暗。"
            },
            {
              "id": "R1",
              "kind": "line",
              "text": "右栏一：镇上的集市逢三逢八，卖菜的摊位排到巷口。"
            },
            {
              "id": "R2",
              "kind": "line",
              "text": "右栏二：老中医的铺子在集市尽头，门口挂着晒干的草药。"
            },
            {
              "id": "R3",
              "kind": "line",
              "text": "右栏三：逢集的日子，铺子里总有人排队，号脉免费。"
            },
            {
              "id": "R4",
              "kind": "line",
              "text": "右栏四：散集之后，街道恢复安静，只剩下落叶和尘土。"
            },
            {
              "id": "F1",
              "kind": "footnote",
              "belongsTo": "L3",
              "text": "① 注：桥头碑文记为旧桥重修，与正文所说去年新修，指同一座桥的两次修缮。"
            }
          ],
