SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
READER_BOOK_ID=finite-infinite-games-1986
READER_OWNER_ID=owner

SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
READER_PUBLIC_ORIGIN=https://YOUR_READER.vercel.app
READER_EMAIL_ENABLED=false
# Enable only after real receipt + login with a verified SMTP sender.
# Resend SMTP and Google/Apple secrets belong in Supabase Auth, not browser env.
# Set DEEPSEEK_API_KEY in the hosting platform to enable bounded translation.
# Media defaults; hosted speech remains unavailable until a durable worker is configured.
OPENROUTER_API_KEY=
READER_SPEECH_MODEL=google/gemini-3.8-flash-tts
READER_IMAGE_MODEL=google/gemini-nano-banana-2.1
READER_DIALOGUE_MODEL=deepseek-chat
