# 托管部署必填。在部署平台配置这些变量，真实密钥不要提交到 Git。
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
READER_PUBLIC_ORIGIN=https://YOUR_READER.vercel.app

# 可选：翻译、阅读对话、讲解稿。
DEEPSEEK_API_KEY=

# 可选：完成真实邮箱收信与登录验收后，再开启验证码入口。
READER_EMAIL_ENABLED=false
# SMTP 和 Google/Apple 登录密钥配置在 Supabase Auth。
# 可选：额外允许的精确 HTTPS 来源，多个来源以逗号分隔。
# READER_ADDITIONAL_WEB_ORIGINS=https://your-other-origin.example.com

# 当前托管服务尚未支持语音任务，无需填写语音 Key。
# 高级模型覆盖与旧变量兼容说明：docs/configuration.md
