{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run verify:hosted",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "regions": [
    "sin1"
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/gift-preview",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ],
  "functions": {
    "api/*.js": {
      "maxDuration": 120,
      "includeFiles": "{catalog/**,server/**,deploy/**,app/*.mjs,harness/**,.reader-runtime/**}"
    }
  },
  "rewrites": [
    {
      "source": "/gift-preview",
      "destination": "/book-gift"
    },
    {
      "source": "/gift/:token",
      "destination": "/book-gift"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/service?path=:path*"
    }
  ]
}
